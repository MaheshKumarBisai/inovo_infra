# Deployment Secrets Template
# Copy this file to .env.deployment and fill in your real values:
#   cp .env.deployment.example .env.deployment
# Then run:
#   ./sync-secrets.sh

# AWS Credentials with permissions to create VPC, EC2, RDS, ALB, S3, ECR
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# RDS PostgreSQL Master Password (must be strong, e.g. 16+ alphanumeric)
DB_PASSWORD=ChangeMeStrongPassword123!

# S3 Bucket for Avatars (must be globally unique across AWS)
S3_BUCKET_NAME=inovo-avatars-yourcompany

# ACM SSL Certificate ARN in us-east-1 (Optional: leave empty to test with HTTP on port 80)
ACM_CERTIFICATE_ARN=
