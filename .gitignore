# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (keep terraform.tfvars.example)
*.tfvars
!terraform.tfvars.example
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan files
tfplan
*.tfplan

# Environment and secrets files (never commit real secrets)
.env*
!.env.deployment.example

# Local cleanup scripts
cleanup-orphans.sh
cleanup*.sh

# OS files
.DS_Store
